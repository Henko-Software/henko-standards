{
	"name": "henko-__name__",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Módulo __name__ de Henko.",
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/main.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node --env-file-if-exists=.env dist/main.js",
		"test": "vitest run",
		"lint": "eslint . --max-warnings=0",
		"check": "prettier --check . && pnpm lint",
		"format": "prettier --write .",
		"typecheck": "tsc -p tsconfig.json",
		"migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@henko-software/audit": "^0.1.2",
		"@henko-software/core": "^0.1.0",
		"@henko-software/errors": "^0.1.0",
		"@henko-software/hexagonal": "^0.1.1",
		"@henko-software/logger": "^0.1.1",
		"@henko-software/nest": "^0.2.0",
		"@henko-software/outbox": "^0.1.2",
		"@henko-software/pg": "^0.2.0",
		"@henko-software/service-auth": "^0.1.0",
		"@henko-software/tracing": "^0.2.0",
		"@henko-software/tracing-node": "^0.1.0",
		"@nestjs/common": "^12.2.0",
		"@nestjs/core": "^12.2.0",
		"@nestjs/platform-express": "^12.2.0",
		"nats": "^2.29.0",
		"pg": "^8.16.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^4.1.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@henko-software/agent-rules": "^0.4.1",
		"@henko-software/commitlint-config": "^0.1.0",
		"@henko-software/eslint-config": "^0.1.1",
		"@henko-software/git-hooks": "^0.1.0",
		"@henko-software/prettier-config": "^0.1.0",
		"@henko-software/testing": "^0.1.0",
		"@henko-software/tsconfig": "^0.1.0",
		"@types/node": "^22.18.0",
		"@types/pg": "^8.15.0",
		"@types/supertest": "^6.0.3",
		"eslint": "^9.39.0",
		"lefthook": "^1.13.0",
		"prettier": "^3.6.2",
		"supertest": "^7.1.0",
		"tsx": "^4.20.0",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	},
	"prettier": "@henko-software/prettier-config"
}
